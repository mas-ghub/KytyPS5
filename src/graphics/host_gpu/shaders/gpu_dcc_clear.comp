#version 450

// Conditional DCC clear of one image layer (dispatched indirectly: zero groups when the metadata
// slice was rejected). Writes the raw texel bits of the accepted clear value through an unsigned
// integer view of the same texel size, then consumes the clear key (every metadata byte 0xFF),
// matching TextureCache's CPU fallback ClearImage + FillBuffer(UINT32_MAX).

layout(local_size_x = 128) in;

layout(set = 0, binding = 0, std430) writeonly buffer Metadata { uint words[]; } metadata;
layout(set = 0, binding = 1, std430) readonly buffer Decision {
	uvec4 dispatch_args;
	uvec4 raw;
} decision;
layout(set = 0, binding = 3) uniform writeonly uimage2D destination_image;

layout(push_constant, std430) uniform Push {
	uint metadata_base_words;
	uint metadata_words;
	uint width;
	uint height;
	uint clear_groups;
	uint decodable_mask;
	uint texel_bytes;
} params;

void main() {
	uvec4 raw = decision.raw;
	if (params.texel_bytes == 1u) {
		raw = uvec4(raw.x & 0xffu, 0u, 0u, 0u);
	} else if (params.texel_bytes == 2u) {
		raw = uvec4(raw.x & 0xffffu, 0u, 0u, 0u);
	} else if (params.texel_bytes == 4u) {
		raw = uvec4(raw.x, 0u, 0u, 0u);
	} else if (params.texel_bytes == 8u) {
		raw = uvec4(raw.x, raw.y, 0u, 0u);
	}
	uint index = gl_GlobalInvocationID.x;
	uint stride = gl_NumWorkGroups.x * 128u;
	uint pixels = params.width * params.height;
	uint elements = max(pixels, params.metadata_words);
	while (index < elements) {
		if (index < pixels) {
			imageStore(destination_image, ivec2(index % params.width, index / params.width), raw);
		}
		if (index < params.metadata_words) {
			metadata.words[params.metadata_base_words + index] = 0xffffffffu;
		}
		// Avoid wrap even for large images when the device limits require strided coverage.
		if (elements - index <= stride) {
			break;
		}
		index += stride;
	}
}
