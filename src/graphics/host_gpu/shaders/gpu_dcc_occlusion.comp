#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Result { uint64_t results[]; } query_data;
layout(set = 0, binding = 1, std430) buffer Counter { uint64_t total; } counter;
layout(set = 0, binding = 2, std430) buffer Output { uint words[]; } output_data;
layout(push_constant) uniform Push { uint mode; uint byte_offset; uint query_count; } push_data;
void main() {
    if (push_data.mode == 0) {
        uint64_t sum = counter.total;
        for (uint i = 0; i < push_data.query_count; ++i) sum += query_data.results[i];
        counter.total = sum & uint64_t(0x7fffffffffffffffUL);
    } else {
        // Aggregate native counts in DB0; the remaining virtual DBs contribute zero.
        // Preserve the other member of every interleaved begin/end pair.
        for (uint db = 0; db < 16; ++db) {
            uint64_t count = db == 0 ? counter.total : uint64_t(0);
            uint index = push_data.byte_offset / 4 + db * 4;
            output_data.words[index] = uint(count);
            output_data.words[index + 1] = uint(count >> 32) | 0x80000000u;
        }
    }
}
